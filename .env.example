# Testnet deploy and demo. Copy to .env and fill in. Never commit the real file.
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Named account that owns the sub-accounts below. Example: nearbowl.testnet
DEPLOYER_ACCOUNT_ID=nearbowl.testnet
# ed25519:... secret. Prefer a credentials file over putting this in a shell history.
DEPLOYER_PRIVATE_KEY=
# Alternative to DEPLOYER_PRIVATE_KEY. JSON with a private_key field. Not committed.
NEAR_CREDENTIALS_FILE=

FACTORY_ACCOUNT_ID=factory.nearbowl.testnet
TUSDC_ACCOUNT_ID=tusdc.nearbowl.testnet

# Optional. Defaults are sub-accounts of DEPLOYER_ACCOUNT_ID, created by the deploy script.
DEMO_CREATOR_ID=
DEMO_ALICE_ID=
DEMO_BOB_ID=
DEMO_CAROL_ID=

# Optional timer overrides for a *new* factory. A code update of an existing
# factory does not change these; they are stored at init. Positive integers.
# Friendlier public demo: 5 minutes of initial life, 1 hour cap below 1,000 USDC,
# 3 hour cap above 100,000 USDC (same 3× span as the demo and production caps).
# Hunger reference stays equal to initial life, matching the demo and production configs.
# INITIAL_LIFE_NS=300000000000
# T_REF_NS=300000000000
# MAX_LIFE_MIN_NS=3600000000000
# MAX_LIFE_MAX_NS=10800000000000
# Also overridable: TWILIGHT_NS, EXT_NS_PER_RAW_USDC, SCAR_STEP_NS, TIER1_NS, TIER2_NS

# Vercel (web/). All of these are public; they are baked into the client bundle.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_FACTORY_ACCOUNT_ID=factory.nearbowl.testnet
NEXT_PUBLIC_USDC_ACCOUNT_ID=tusdc.nearbowl.testnet
