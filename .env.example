# Testnet deploy and the demo script. Copy to .env and fill in. Never commit the real file.
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Named account that owns the sub-accounts below. Example: nearbowl.testnet
DEPLOYER_ACCOUNT_ID=nearbowl.testnet
# ed25519:... secret. Prefer a credentials file over putting this in a shell history.
DEPLOYER_PRIVATE_KEY=
# Alternative to DEPLOYER_PRIVATE_KEY. JSON with a private_key field. Not committed.
NEAR_CREDENTIALS_FILE=

# Public factory. Created as a sub-account of nearbowl.testnet, timer controls off.
FACTORY_ACCOUNT_ID=pet.nearbowl.testnet
TUSDC_ACCOUNT_ID=tusdc.nearbowl.testnet
# Legacy short-timer factory. scripts/demo.mjs only. The app does not use it.
LEGACY_FACTORY_ACCOUNT_ID=factory.nearbowl.testnet
# Leave false for the public factory. true is only for a non-public legacy factory.
ALLOW_DEMO_CONTROLS=false

# Optional. Defaults are sub-accounts of DEPLOYER_ACCOUNT_ID, created by the deploy script.
DEMO_CREATOR_ID=
DEMO_ALICE_ID=
DEMO_BOB_ID=
DEMO_CAROL_ID=

# Timers for a new factory. A code update of an existing factory does not change
# these; they are stored at init. Used for pet.nearbowl.testnet.
# Timer controls stay off (ALLOW_DEMO_CONTROLS).
# 24 hour initial life, 48 hour cap below 1,000 USDC, 72 hour cap above 100,000 USDC,
# 2 hour twilight, 6 minutes of life per USDC, 6 hour feeding tiers, 90 minute scar step.
# Other params stay on the deploy script defaults. Positive integers.
INITIAL_LIFE_NS=86400000000000
T_REF_NS=86400000000000
MAX_LIFE_MIN_NS=172800000000000
MAX_LIFE_MAX_NS=259200000000000
TWILIGHT_NS=7200000000000
EXT_NS_PER_RAW_USDC=360000
TIER1_NS=21600000000000
TIER2_NS=21600000000000
SCAR_STEP_NS=5400000000000

# Vercel (web/). All of these are public; they are baked into the client bundle.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_FACTORY_ID=pet.nearbowl.testnet
# Older name, used only when NEXT_PUBLIC_FACTORY_ID is unset.
NEXT_PUBLIC_FACTORY_ACCOUNT_ID=pet.nearbowl.testnet
NEXT_PUBLIC_USDC_ACCOUNT_ID=tusdc.nearbowl.testnet

# Server-only. Vercel Blob token for coin pictures. Do not prefix with NEXT_PUBLIC.
# Leave empty locally to launch without pictures.
BLOB_READ_WRITE_TOKEN=
